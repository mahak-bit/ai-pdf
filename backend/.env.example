# Copy to backend/.env and fill in. Never commit .env.

# auto | gemini | ollama | none
#   auto: Gemini if GEMINI_API_KEY is set, else Ollama if reachable, else retrieval-only
LLM_PROVIDER=auto

# Free key: https://aistudio.google.com/apikey  (server-side only; never put it in the frontend)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Tried in order if the main model is overloaded or out of daily quota
GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-flash-lite-latest

# Local fallback: install Ollama, then `ollama pull llama3.2:3b`
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
LLM_TIMEOUT_SECONDS=60

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000

# Optional tuning
# EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# TOP_K=5
# MIN_RELEVANCE=0.12
# CHUNK_MAX_CHARS=600
# CHUNK_OVERLAP_CHARS=120
# MAX_UPLOAD_MB=20
# MAX_PAGES=500
# DATA_DIR=./data
